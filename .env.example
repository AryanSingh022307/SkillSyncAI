# Required for auth. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Optional — enables "Continue with Google" on /login and /signup. Without these,
# the site falls back to email/password only. See README for how to create them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# All optional. Without them SkillSync AI runs on its local deterministic engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
